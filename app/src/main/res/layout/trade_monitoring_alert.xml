<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="#DDECCB">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠ هشدار شدید مانیتورینگ معاملات" android:textColor="#315C32" android:textSize="27sp" android:textStyle="bold" android:gravity="center" android:layout_marginBottom="12dp" />
    <TextView android:id="@+id/tradeAlertReasonText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="افزایش شدید فعالیت معاملاتی شناسایی شد" android:textColor="#333039" android:textSize="17sp" android:gravity="center" android:layout_marginBottom="22dp" />
    <TextView android:id="@+id/tradeAlertScoreText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="امتیاز هشدار: --" android:textColor="#7B1FA2" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:background="#EEF4E9" android:padding="14dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/tradeAlertCountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تعداد معاملات: --" android:textColor="#333039" android:textSize="17sp" android:gravity="center" android:background="#EEF4E9" android:padding="12dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/tradeAlertLargeCountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="معاملات ≥ ۱۰۰۰ تتر: --" android:textColor="#333039" android:textSize="17sp" android:gravity="center" android:background="#EEF4E9" android:padding="12dp" android:layout_marginBottom="26dp" />
    <Button android:id="@+id/tradeAlertAcknowledgeButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="هشدار مشاهده شد" android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/tradeAlertMonitorButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="مشاهده صفحه مانیتورینگ" android:textSize="17sp" />
</LinearLayout>
