<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 مانیتورینگ معاملات"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/marketStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9EAD3"
            android:padding="18dp"
            android:text="🟢 عادی"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0/100"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/buyPressureText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فشار خرید: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/sellPressureText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فشار فروش: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حجم معاملات: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/speedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سرعت معاملات: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/largeTradeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="معاملات بزرگ: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/priceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخرین قیمت: --"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 چرا این وضعیت محاسبه شده؟"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9EAD3"
            android:padding="14dp"
            android:text="در انتظار دریافت معاملات..."
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخرین معاملات"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/latestTradesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/refreshTradesButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="به‌روزرسانی معاملات"
            android:textSize="17sp"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
