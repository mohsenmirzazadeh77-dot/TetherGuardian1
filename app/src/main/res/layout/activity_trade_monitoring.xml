<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مانیتورینگ معاملات"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center" />

        <TextView
            android:id="@+id/monitorSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پایش معاملات واقعی بازار USDT/IRT نوبیتکس"
            android:textSize="13sp"
            android:textColor="#66616D"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/marketStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● در حال دریافت داده..."
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2E7D32"
            android:background="#DDECCB"
            android:padding="14dp" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شاخص رفتار غیرعادی: -- / 100"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4527A0"
            android:gravity="center"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/buyPressureText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="فشار خرید\n--"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:background="#DDECCB"
                android:padding="14dp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/sellPressureText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="فشار فروش\n--"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#EF6C00"
                android:gravity="center"
                android:background="#DDECCB"
                android:padding="14dp"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="در حال دریافت معاملات..."
            android:textSize="15sp"
            android:textColor="#333039"
            android:background="#DDECCB"
            android:padding="15dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="چرایی وضعیت\nداده‌های پایش پس از دریافت معاملات نمایش داده می‌شوند."
            android:textSize="15sp"
            android:textColor="#333039"
            android:background="#DDECCB"
            android:padding="15dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/latestTradesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخرین معاملات\n--"
            android:textSize="14sp"
            android:textColor="#333039"
            android:background="#DDECCB"
            android:padding="15dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/refreshTradesButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="دریافت مجدد معاملات"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
