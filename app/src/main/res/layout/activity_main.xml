<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF4"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نگهبان تتر" android:textSize="30sp" android:textStyle="bold" android:textColor="#315C32" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOBITEX • LIVE" android:textSize="13sp" android:textColor="#687067" android:gravity="center" android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/monitoringStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● پایش غیرفعال" android:textColor="#C62828" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/monitoringButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="فعال کردن برنامه" android:textSize="16sp" android:layout_marginBottom="10dp" />
        <Button android:id="@+id/tradeMonitoringButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="📊 مانیتورینگ معاملات" android:textSize="16sp" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قیمت مبنا" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="2dp" />
        <TextView android:id="@+id/baseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textColor="#1976D2" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_pistachio_card" />
        <TextView android:id="@+id/baseTimeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="زمان ثبت: --" android:textSize="13sp" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="میزان کاهش برای هشدار" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_pistachio_card" />
        <Spinner android:id="@+id/dropPercentSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_pistachio_card" />
        <TextView android:id="@+id/dropPercentText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۳٪" android:textSize="15sp" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حد ریزش" android:textColor="#F9A825" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_pistachio_card" />
        <TextView android:id="@+id/dropLimitText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textColor="#F9A825" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قیمت لحظه‌ای" android:textColor="#9C27B0" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_pistachio_card" />
        <TextView android:id="@+id/priceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textColor="#9C27B0" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="صدای هشدار" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_pistachio_card" />
        <Spinner android:id="@+id/soundSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_pistachio_card" />
        <Button android:id="@+id/soundTestButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="آزمایش صدای انتخاب‌شده" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/alertPreviewButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="آزمایش صفحه هشدار" android:textSize="16sp" android:layout_marginBottom="10dp" />

        <TextView android:id="@+id/connectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● در حال اتصال..." android:textColor="#F44336" android:textSize="17sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_pistachio_card" />
        <TextView android:id="@+id/updateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آخرین دریافت: --" android:textSize="13sp" android:gravity="center" android:background="@drawable/bg_pistachio_card" android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
