<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نگهبان تتر"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOBITEX • LIVE"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/monitoringStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● پایش غیرفعال"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/monitoringButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="فعال کردن برنامه"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قیمت مبنا"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/baseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/baseTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="زمان ثبت: --"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="میزان کاهش برای هشدار"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/dropPercentSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/dropPercentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۳٪"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حد ریزش"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dropLimitText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/connectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● در حال اتصال..."
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تایم‌فریم مبنا"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/timeframeSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open کندل مبنا"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/openText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قیمت لحظه‌ای"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/priceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تغییر نسبت به Open"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/changeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="به‌روزرسانی Open کندل"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/updateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخرین دریافت: --"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
